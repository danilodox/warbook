    <string name="verify_step_1">In the game, open Settings (gear).</string>
    <string name="verify_step_2">Tap More Settings.</string>
    <string name="verify_step_3">Scroll to API Token and tap Show.</string>
    <string name="verify_step_4">Tap Copy and come back here.</string>
