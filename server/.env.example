# Copie este arquivo para server/.env (que fica fora do git) e preencha os valores.
# O `./gradlew :server:run` lê o server/.env e passa as linhas como variáveis de ambiente.

# Chave da API oficial (https://developer.clashofclans.com), presa ao IP público de onde o servidor roda.
COC_API_KEY=

# Segredo que assina os tokens das instalações. Pelo menos 32 caracteres aleatórios.
JWT_SECRET=
